# ============================================================
#  BloodLink Pro — Environment Variables
#  Copy this to .env and fill in your values
# ============================================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/bloodlink_pro
# For MongoDB Atlas use:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/bloodlink_pro?retryWrites=true&w=majority

# JWT Secret (change this to a long random string in production!)
JWT_SECRET=bloodlink_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Email (optional - for OTP emails)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
